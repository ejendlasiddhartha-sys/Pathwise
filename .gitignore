# ------------------------------------------------------------
# 9. ENVIRONMENT VARIABLES AND SECRETS
# ------------------------------------------------------------

# Never commit actual environment files
.env
.env.*
.envrc

# Allow example environment files
!.env.example
!**/.env.example

# Explicit application environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# Secret and credential files
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json


